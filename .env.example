# Copy to .env and fill in. Never commit .env.
# Every setting is read by engine/src/config.py; no literals are scattered through modules.

# --- core services -----------------------------------------------------------
HEALOPS_DATABASE_URL=postgresql+asyncpg://healops_app:healops@localhost:5432/healops
HEALOPS_REDIS_URL=redis://localhost:6379/0
HEALOPS_ENVIRONMENT=local

# --- observability -----------------------------------------------------------
# Alertmanager API v2 only. v1 was removed in 0.27.
HEALOPS_ALERTMANAGER_URL=http://localhost:9093
HEALOPS_PROMETHEUS_URL=http://localhost:9090

# Shared secret Alertmanager presents on the webhook. Compared in constant time.
HEALOPS_WEBHOOK_SHARED_SECRET=change-me

# --- Slack -------------------------------------------------------------------
# Leave blank to run without Slack: the engine still acts within policy, the ledger
# and dashboard keep working, and approvals are HELD rather than executed.
HEALOPS_SLACK_BOT_TOKEN=
HEALOPS_SLACK_SIGNING_SECRET=
HEALOPS_SLACK_CHANNEL=#healops-incidents

# --- approvals ---------------------------------------------------------------
# Bearer token for POST /api/approvals (the dashboard's server-side approve path).
# Blank means the endpoint refuses every decision and Slack is the only way to approve.
HEALOPS_APPROVALS_API_TOKEN=
HEALOPS_APPROVAL_TIMEOUT_SECONDS=600

# --- verification ------------------------------------------------------------
# Failure may be called from 60s after the action; success only after the full window.
HEALOPS_VERIFICATION_WINDOW_SECONDS=300
HEALOPS_VERIFICATION_EARLY_AFTER_SECONDS=60
HEALOPS_VERIFICATION_SETTLE_SECONDS=30
# The watchdog force-reverts anything still unverified past this.
HEALOPS_VERIFICATION_DEADLINE_SECONDS=900

# --- object storage (MinIO locally, S3 in cloud) -----------------------------
HEALOPS_S3_ENDPOINT=http://localhost:9000
HEALOPS_S3_BUCKET=healops-archives
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# --- GitHub (durable remediation PRs and masking-guard issues) ---------------
# Fine-grained PAT scoped to contents + pull requests on ONE repository.
HEALOPS_GITHUB_TOKEN=
HEALOPS_GITHUB_REPO=owner/manifests-repo

# --- Kubernetes --------------------------------------------------------------
# Unset in-cluster; the engine falls back to the ServiceAccount.
KUBECONFIG=

# --- optional LLM narrator ---------------------------------------------------
# TemplateNarrator is the default. The system works with no API key and no network.
HEALOPS_NARRATOR=template
HEALOPS_LLM_MODEL=
HEALOPS_LLM_API_KEY=
